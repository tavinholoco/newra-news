# Servidor
PORT=3001
NODE_ENV=development
HOST=0.0.0.0

# Banco de Dados (Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/newranews

# APIs de Noticias
NEWSAPI_KEY=sua_chave_aqui

# IA — Gemini (principal)
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-1.5-flash

# IA — Groq (fallback)
GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=llama-3.1-8b-instant

# Seguranca
JOB_SECRET=token_secreto_para_trigger_do_pipeline
CORS_ORIGIN=http://localhost:3000

# Cron (fallback interno)
CRON_SCHEDULE=0 8 * * *
CRON_TIMEZONE=America/Sao_Paulo
