[TEMPLATE]
# === Backend — Environment Variables ===
# Copy this file to .env and fill in the values.

# Servidor
PORT=3001
NODE_ENV=development
HOST=0.0.0.0

# Banco de Dados (Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/newranews

# APIs de Noticias
# NewsData.io (provider principal — free tier 200 creditos/dia, ~2.000 artigos/dia)
NEWSDATA_API_KEY=sua_chave_newsdata_aqui

# IA — Gemini (principal)
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

# IA — Groq (fallback)
GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=llama-3.1-8b-instant

# Seguranca
JOB_SECRET=token_secreto_para_trigger_do_pipeline
CORS_ORIGIN=http://localhost:3000

# Cron (fallback interno)
CRON_SCHEDULE=0 8 * * *
CRON_TIMEZONE=America/Sao_Paulo

# Newsletter (opcional — sem RESEND_API_KEY o envio é pulado)
# Criar chave em https://resend.com/api-keys (free tier: 100 emails/dia)
RESEND_API_KEY=sua_chave_resend_aqui
# URL pública do frontend (usada no link do artigo no e-mail)
SITE_URL=http://localhost:3000
# Remetente com domínio verificado no Resend (formato: Nome <email@dominio.com>)
NEWSLETTER_FROM=Newra News <news@newranews.com>

# Auth — JWT compartilhado com o frontend (web assina, API valida).
# Deve ser IGUAL ao AUTH_JWT_SECRET do apps/web (em produção: Render + Vercel).
AUTH_JWT_SECRET=segredo_compartilhado_web_api
# E-mails que nascem com role ADMIN (separados por vírgula; opcional)
ADMIN_EMAILS=
