[TEMPLATE]
# === Frontend — Environment Variables ===
# Copy this file to .env.local and fill in the values

# Backend API URL (used by both server & client components)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api

# Site URL for SEO (sitemap, canonical URLs, Open Graph)
# Obrigatorio apenas para dominio customizado. No deploy da Vercel, se ausente,
# o site deriva automaticamente de VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Vercel Cron — auth token (auto-injected by Vercel when set in dashboard)
CRON_SECRET=

# Backend job trigger — called by the cron route
BACKEND_JOB_URL=https://your-backend.onrender.com/api/jobs/daily-pipeline
BACKEND_JOB_SECRET=

# === Auth (next-auth v4 + JWT compartilhado com a API) ===
# URL base do site (obrigatorio para OAuth em produção)
NEXTAUTH_URL=https://your-domain.vercel.app

# Secret do next-auth (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET=

# Secret compartilhado com a API (apps/api/.env -> AUTH_JWT_SECRET).
# DEVE ser idêntico nos dois apps: a API valida os JWTs que o web assina.
AUTH_JWT_SECRET=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
