generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model News {
  id          String   @id @default(uuid())
  title       String
  description String
  content     String?
  source      String
  sourceUrl   String   @unique
  imageUrl    String?
  category    Category
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([publishedAt])
  @@index([createdAt])
}

model Article {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  summary   String
  date      DateTime @unique
  newsCount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auditoria da geração (plano V2 §18.4). Nullable por causa dos artigos
  // publicados antes desta migration — não há como preenchê-los retroativamente.
  generatedAt   DateTime?
  promptVersion String?
  modelVersion  String?
  status        ArticleStatus @default(PUBLISHED)

  sources BriefingSource[]

  @@index([date])
}

/// Notícia que originou o briefing do dia, na ordem em que foi enviada à IA.
/// Os campos de exibição são desnormalizados de propósito: o Stage 8 do
/// pipeline apaga News com mais de 30 dias, e o Article vive 90 — sem copiar
/// título/fonte/URL, dois terços dos briefings retidos ficariam sem lista de
/// fontes, que é justamente o que a §18.4 quer auditar.
///
/// A chave natural é `sourceUrl` (é `@unique` em News e nunca falta), não
/// `newsId` — que é um ponteiro fraco, sem FK como em Favorite, nulo quando a
/// notícia não pôde ser resolvida e obsoleto depois que o cleanup a remove.
model BriefingSource {
  id        String   @id @default(uuid())
  articleId String
  newsId    String?
  position  Int
  title     String
  source    String
  sourceUrl String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, sourceUrl])
  @@index([articleId, position])
}

model PipelineLog {
  id          String          @id @default(uuid())
  status      PipelineStatus
  newsCount   Int             @default(0)
  articleId   String?
  // Erro da falha (legado — string única); os novos campos estruturados são
  // errorStage/errorDetail (observabilidade, item 9)
  error       String?
  // Etapa da falha (Stage 1–9, ex.: 7.5 newsletter) — null quando não falhou
  errorStage  Float?
  // Erro estruturado: { message, provider?, statusCode? }
  errorDetail Json?
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  events      PipelineEvent[]
}

model PipelineEvent {
  id            String              @id @default(uuid())
  pipelineLogId String
  stage         Float               // Stage 1–9 (ex.: 7.5 = newsletter)
  level         PipelineEventLevel
  message       String
  context       Json?
  createdAt     DateTime            @default(now())

  pipelineLog PipelineLog @relation(fields: [pipelineLogId], references: [id], onDelete: Cascade)

  @@index([pipelineLogId, createdAt])
  @@index([level])
  @@index([stage])
  @@index([createdAt])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  image     String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  newsId    String
  createdAt DateTime @default(now())

  @@unique([userId, newsId])
  @@index([userId, createdAt])
}

model Subscriber {
  id        String           @id @default(uuid())
  email     String           @unique
  status    SubscriberStatus @default(ACTIVE)
  token     String           @unique @default(uuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
}

model NewsletterLog {
  id        String   @id @default(uuid())
  date      DateTime @unique
  articleId String?
  total     Int      @default(0)
  sent      Int      @default(0)
  failed    Int      @default(0)
  error     String?
  createdAt DateTime @default(now())

  @@index([date])
}

model DailyMetric {
  id               String   @id @default(uuid())
  date             DateTime @unique
  newsCollected    Int      @default(0)
  newsByCategory   Json     @default("{}")
  articleGenerated Boolean  @default(false)
  pipelineDuration Int?
  aiProvider       String?
  aiTokensUsed     Int?
  pipelineErrors   Int      @default(0)
  newsApiCount     Int      @default(0)
  rssCount         Int      @default(0)
  cleanupCount     Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([date])
}

enum Category {
  TECHNOLOGY
  POLITICS
  ECONOMY
  SPORTS
  SCIENCE
  ENTERTAINMENT
  WORLD
  HEALTH
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  FAILED
}

enum PipelineStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum PipelineEventLevel {
  INFO
  WARN
  ERROR
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum UserRole {
  USER
  ADMIN
}
