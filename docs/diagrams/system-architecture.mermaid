%% Diagrama de Arquitetura do Sistema — Newra News
%% ---
%% Atualizado em 01/09/2026, depois das Fases 0–12 da V2, e em 10/10/2026 com o
%% que o plano de observabilidade pôs em volta: o Heartbeat de fora, a sonda do
%% login e os passos 3 e 4 do cron. Este é o mapa de
%% caixas grandes: o detalhe das rotas do frontend está em
%% `frontend-routes.mermaid`, o da sessão em `auth-flow.mermaid`, e o do
%% pipeline em `pipeline-sequence.mermaid`.
%% ---
%% **Não há keep-alive.** A API dorme no plano free do Render com ~15 min sem
%% tráfego, e isso é decisão medida desde 01/09/2026 — quem precisa dela quente
%% acorda antes de chamar (é o que o passo 1 do cron faz). Ver `docs/setup.md`.
flowchart TB
    U["👤 Leitor<br/>(navegador)"]

    subgraph Frontend["FRONTEND — Vercel"]
        W["Next.js 14 · App Router<br/>Tailwind CSS 4 + Base UI<br/>next-intl · /pt-BR e /en"]
        PUB["Rotas de leitura<br/>(estáticas com ISR)"]
        PRIV["Rotas de conta e admin<br/>(exigem sessão)"]
        BFF["BFF — app/api/*<br/>assina um JWT por requisição —<br/>menos /events e /errors/client, anônimas"]
        CR["API Route<br/>/api/cron/daily-news"]
        PROBE["Sonda do login<br/>/api/health/auth · ISR de um dia"]
        W --- PUB
        W --- PRIV
        PRIV --> BFF
        PUB -.->|"analytics (sendBeacon) e relato de erro<br/>sem sessão, sem JWT"| BFF
    end

    subgraph Backend["BACKEND — Render"]
        API["Fastify 4 · TypeScript · Prisma<br/>Zod · Rate-limit · CORS · Helmet<br/>OpenAPI sempre gerado, UI só fora de produção"]
        PL["Pipeline diário<br/>(14 etapas)"]
        JOBS["Cron interno · @fastify/schedule<br/>(só dispara se o processo estiver de pé)"]
        API --> PL
        JOBS --> PL
    end

    subgraph Data["DADOS E SERVIÇOS EXTERNOS"]
        DB[("PostgreSQL — Neon")]
        ND["NewsData.io<br/>(provider principal)"]
        RSS["RSS Feeds<br/>(11 fontes)"]
        GEM["Gemini API<br/>(IA principal)"]
        GROQ["Groq API<br/>(IA fallback)"]
        RES["Resend<br/>(newsletter diária)"]
        OA["Google · GitHub<br/>(OAuth)"]
    end

    U --> W
    VC["Vercel Cron<br/>0 11 * * * UTC = 08:00 BRT"] -->|"GET /api/cron/daily-news<br/>Bearer CRON_SECRET"| CR
    CR -->|"1 · GET /api/health<br/>acorda a instância"| API
    CR -->|"2 · POST /api/jobs/daily-pipeline<br/>Bearer JOB_SECRET"| API
    CR -->|"3 · GET /api/jobs/:id até o run fechar"| API
    CR -->|"4 · invalida pela rota irmã e pede as páginas do dia,<br/>conferindo a marca do run"| PUB
    CR -.->|"4 · regenera"| PROBE
    PROBE -->|"JWT purpose health-probe"| API

    HB["GitHub Actions · Heartbeat<br/>12:40 UTC — o job reprovado é o e-mail"]
    HB -->|"site · as duas Homes · a sonda do login"| W
    HB -->|"/api/health · o briefing de hoje<br/>(e se é suspensão do Render)"| API

    PUB -->|"HTTP REST · JSON"| API
    BFF -->|"Bearer JWT · AUTH_JWT_SECRET"| API
    W <-->|"OAuth · next-auth"| OA

    PL -->|"fetch paralelo<br/>Promise.allSettled"| ND
    PL -->|"fetch"| RSS
    PL -->|"gera o briefing do dia"| GEM
    GEM -.->|"fallback automático"| GROQ
    PL -->|"envio diário"| RES
    PL <-->|"Prisma ORM"| DB
    API <-->|"Prisma ORM"| DB
