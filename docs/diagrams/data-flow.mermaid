%% Fluxo de Dados Diário — Pipeline de Notícias (Newra News)
%% ---
%% Atualizado em 16/09/2026. As 12 etapas do `pipeline.service.ts`, na ordem em
%% que rodam, e o que cada uma deixa gravado. A etapa 4 grava também a
%% SourceHealth do dia (Fase 11 do plano de observabilidade), e a 8 a expurga.
%% A 9.5 (Fase 6) não grava tabela nenhuma: o relatório é o `context` de um
%% PipelineEvent, e cada violação é um ErrorEvent com o id da invariante.
flowchart TB
    subgraph Coleta["Fontes"]
        ND["NewsData.io"]
        RSS["RSS · 12 feeds"]
    end

    S1["1 · Coleta<br/>(NewsData + RSS em paralelo)"]
    S2["2 · Normalização<br/>(→ RawNewsItem · dek e corpo separados)"]
    S3["3 · Deduplicação<br/>(por sourceUrl)"]
    S4["4 · Persistência<br/>(news.createMany · SourceHealth do dia)"]
    S5["5 · Seleção<br/>(15 mais recentes)"]
    S6["6 · Geração IA<br/>(Gemini → Groq fallback)"]
    S7["7 · Persistência do briefing<br/>(article.upsert + BriefingSource)"]
    S75["7.5 · Newsletter<br/>(Resend — não crítico)"]
    S8["8 · Expurgo<br/>(news >30d · logs >30d<br/>artigos, eventos e fontes >90d · erros >14d · auditoria >365d)"]
    S85["8.5 · Renormalização<br/>(reaplica as regras ao acervo gravado)"]
    S9["9 · Métricas<br/>(dailyMetric.upsert)"]
    S95["9.5 · Invariantes<br/>(12 consultas agregadas — retenção, briefing,<br/>run morto, métrica do dia, newsletter)"]

    ND --> S1
    RSS --> S1
    S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7 --> S75 --> S8 --> S85 --> S9 --> S95

    SITE["Site — Next.js com ISR"]
    S4 -.->|"acervo de notícias"| SITE
    S7 -.->|"briefing do dia"| SITE
    S9 -.->|"painel de admin"| SITE
    S95 -.->|"painel de invariantes"| SITE

    LOG["PipelineLog + PipelineEvent<br/>(uma linha por etapa)"]
    S1 -.-> LOG
    S6 -.-> LOG
    S85 -.-> LOG
    S95 -.->|"relatório no context"| LOG

    ERR["ErrorEvent<br/>(uma linha por invariante violada)"]
    S95 -.-> ERR
